# ==========================================
# FilmHouse Telegram File Streaming Bot Config
# ==========================================

# 1. Telegram API Credentials (from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# 2. Telegram Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRstuVWXyz

# 3. Bin Storage Channel ID (Make a private channel, add bot as admin, get ID)
# Must start with -100 (e.g. -1002345678901)
BIN_CHANNEL_ID=-1001234567890

# 4. Web Server Settings
HOST=0.0.0.0
PORT=8080
# The public URL where videos are streamed from (without trailing slash)
# For local testing: http://localhost:8080
# For VPS with domain/tunnel: https://stream.filmhouse.com or https://xxxx.trycloudflare.com
SERVER_URL=http://localhost:8080

# 5. Security & Hotlink Protection
# Secret key used for signing video tokens (generates /watch/<token>)
SECRET_KEY=change_this_to_a_random_secure_secret_key_32_chars!

# Allowed origins for embedding/streaming (comma-separated, or * for all)
# Example: https://filmhouse.com,https://filmhouse-app.web.app
ALLOWED_ORIGINS=*

# Optional: Admin Telegram User IDs allowed to use the bot (leave blank to allow all users)
# Example: 12345678,87654321
ADMIN_IDS=
